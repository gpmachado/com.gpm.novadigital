{
  "id": "com.gpm.novadigital",
  "version": "1.1.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "NovaDigital"
  },
  "description": {
    "en": "Wall switches (1-6 gang) and smart plugs for NovaDigital Zigbee devices."
  },
  "category": [
    "appliances"
  ],
  "brandColor": "#2E6AB3",
  "permissions": [],
  "source": "https://github.com/gpmachado/com.gpm.novadigital",
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "author": {
    "name": "Gabriel Pedrosa Machado",
    "email": "g.machado@me.com"
  },
  "api": {
    "getMessageStats": {
      "method": "GET",
      "path": "/message-stats"
    },
    "resetMessageStats": {
      "method": "POST",
      "path": "/message-stats/reset"
    },
    "resetRejoinStats": {
      "method": "POST",
      "path": "/rejoin-stats/reset"
    }
  }
}